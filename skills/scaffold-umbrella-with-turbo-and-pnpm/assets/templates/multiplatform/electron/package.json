    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "electron": "33.3.1",
    "prettier": "^3.8.1",
    "typescript": "~5.7.3"
  }
}
