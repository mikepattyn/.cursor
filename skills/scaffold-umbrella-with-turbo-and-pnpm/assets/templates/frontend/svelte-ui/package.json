{
  "name": "@umbrella/example-calculator-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "lint": "prettier --check .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "svelte": "5.16.2"
  },
  "dependencies": {
    "@umbrella/calculator-client": "workspace:*",
    "@umbrella/example-calculator": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "svelte": "5.16.2",
    "svelte-check": "4.1.4",
    "typescript": "~5.7.3"
  }
