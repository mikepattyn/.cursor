    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "prettier": "^3.8.1",
    "typescript": "~5.7.3"
  }
