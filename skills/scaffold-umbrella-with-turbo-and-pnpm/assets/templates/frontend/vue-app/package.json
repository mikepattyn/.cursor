{
  "name": "@umbrella/example-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4200",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "lint": "prettier --check .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@umbrella/example-calculator-ui": "workspace:*",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.7.3",
    "vite": "6.0.11",
    "vue-tsc": "2.2.0"
  }
}
