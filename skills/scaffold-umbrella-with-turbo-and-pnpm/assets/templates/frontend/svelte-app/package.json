{
  "name": "@umbrella/example-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4200",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "lint": "prettier --check .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@umbrella/example-calculator-ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "prettier": "^3.8.1",
    "svelte": "5.16.2",
    "svelte-check": "4.1.4",
    "typescript": "~5.7.3",
    "vite": "6.0.11"
  }
}
