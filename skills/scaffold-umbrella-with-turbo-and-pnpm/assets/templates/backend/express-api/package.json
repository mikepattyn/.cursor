{
  "name": "@umbrella/example-calculator-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --experimental-sqlite --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-sqlite dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test src/**/*.test.ts",
    "lint": "prettier --check .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
