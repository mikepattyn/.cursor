{
  "name": "umbrella-node22",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"]
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@9.15.9 --activate",
  "remoteUser": "node",
  "comment": "Opt-in Node 22. Add the .NET 10 SDK feature when editing the API in the container."
}
